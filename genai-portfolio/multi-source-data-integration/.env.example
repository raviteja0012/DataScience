# =============================================================================
# Multi-Source Data Integration - environment configuration
# =============================================================================
# Copy this file to `.env` and fill in the values for your environment.
#   cp .env.example .env
# Never commit `.env` - only `.env.example` belongs in version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application behaviour
# -----------------------------------------------------------------------------
# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# When true, the pipeline runs against bundled fixtures and skips real DBs.
DEMO_MODE=true

# -----------------------------------------------------------------------------
# Source: Oracle (legacy ERP)
# -----------------------------------------------------------------------------
SOURCE_ORACLE_HOST=oracle.example.com
SOURCE_ORACLE_PORT=1521
SOURCE_ORACLE_SERVICE=ORCLPDB1
SOURCE_ORACLE_USER=app_user
SOURCE_ORACLE_PASSWORD=change_me

# -----------------------------------------------------------------------------
# Source: Microsoft SQL Server
# -----------------------------------------------------------------------------
SOURCE_MSSQL_HOST=mssql.example.com
SOURCE_MSSQL_PORT=1433
SOURCE_MSSQL_DATABASE=Billing
SOURCE_MSSQL_USER=app_user
SOURCE_MSSQL_PASSWORD=change_me

# -----------------------------------------------------------------------------
# Target: Snowflake
# -----------------------------------------------------------------------------
TARGET_SNOWFLAKE_ACCOUNT=your_account.region
TARGET_SNOWFLAKE_USER=your_user
TARGET_SNOWFLAKE_PASSWORD=change_me
TARGET_SNOWFLAKE_WAREHOUSE=COMPUTE_WH
TARGET_SNOWFLAKE_DATABASE=INTEGRATION_DB
TARGET_SNOWFLAKE_SCHEMA=PUBLIC
TARGET_SNOWFLAKE_ROLE=SYSADMIN

# -----------------------------------------------------------------------------
# Optional credentials for the bundled compose source services
# -----------------------------------------------------------------------------
# ORACLE_PASSWORD=oracle
# ORACLE_APP_USER=app_user
# ORACLE_APP_USER_PASSWORD=app_user
# MSSQL_SA_PASSWORD=Str0ng!Passw0rd
