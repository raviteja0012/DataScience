# =============================================================================
# Biller Integration Simulator - environment configuration
# =============================================================================
# Copy this file to `.env` and edit the values you want to override.
#   cp .env.example .env
# All variables below are OPTIONAL - the application has sensible defaults.
# =============================================================================

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# When true, the simulator runs in demo mode using bundled fixture data
# and never reaches out to external systems.
DEMO_MODE=true

# Directory inside the container where generated payment files are written.
# Map this to a host path or named volume in docker-compose.yml.
OUTPUT_DIR=/app/output
