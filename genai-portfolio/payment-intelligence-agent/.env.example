# =============================================================================
# Payment Intelligence Agent - environment configuration
# =============================================================================
# Copy this file to `.env` and fill in the values for your environment.
#   cp .env.example .env
# Never commit `.env` - only `.env.example` belongs in version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application behaviour
# -----------------------------------------------------------------------------
# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# When true, the agent runs against bundled fixtures and skips Snowflake calls.
DEMO_MODE=true

# Sentence-transformers model used for RAG embeddings.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Snowflake connection (required when DEMO_MODE=false)
# -----------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=your_account.region
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=PAYMENTS_DB

# Optional: override the default schema or role
# SNOWFLAKE_SCHEMA=PUBLIC
# SNOWFLAKE_ROLE=ANALYST

# -----------------------------------------------------------------------------
# Optional cache (used when the `cache` Compose profile is enabled)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
